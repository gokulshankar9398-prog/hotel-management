# ==============================================================
# Grand Royale – Smart Hotel Booking System - Configuration
# ==============================================================

# Server Port
PORT=3000

# --------------------------------------------------------------
# 1. Brevo (Sendinblue) Configuration (Recommended)
# --------------------------------------------------------------
# 300 Free emails/day to ANY recipient email address!
BREVO_API_KEY=
# Set this to the email address you used when signing up for Brevo:
BREVO_SENDER_EMAIL=

# --------------------------------------------------------------
# 2. Gmail SMTP Configuration (Alternative)
# --------------------------------------------------------------
# Set up a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# --------------------------------------------------------------
# 3. Resend API Configuration (Alternative)
# --------------------------------------------------------------
RESEND_API_KEY=

# --------------------------------------------------------------
# 4. Optional Mobile Gateways
# --------------------------------------------------------------
CALLMEBOT_API_KEY=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
